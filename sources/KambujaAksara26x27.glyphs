{
code = "script khmr;
language dflt;

lookup stack_consonants_step1;
lookup stack_consonants_step2;

sub [uni178C]' @conj.rili by [uni178C.alt];

# --- setup old grammar conjunction
sub @consonants [uni17BB uni17BC uni17BD] @conj.cons.l1.002' by @conj.cons.l2.002;
sub [@conj.cons.l1 @conj.cons.l2.002 @conj.cons.l3.002] [uni17BB uni17BC uni17BD] @conj.cons.l1.002' by @conj.cons.l3.002;


# ----- replace to b6 ------
sub uni1794' @conj.cons.l1.001 uni17B6 by uni1794_17B6.alt;
sub uni1794' @conj.cons.l1 @conj.cons.l1.001 uni17B6 by uni1794_17B6.alt;
sub uni1794' @conj.cons.l1 [@conj.cons.l1.001 @conj.cons.l2.002] @conj.cons.l1.001 uni17B6 by uni1794_17B6.alt;
sub uni1794' @vannayutti uni17B6 by uni1794_17B6.alt;
sub uni1794' @conj.cons.l1.001 @vannayutti uni17B6 by uni1794_17B6.alt;
sub uni1794' @conj.cons.l1 @conj.cons.l1.001 @vannayutti uni17B6 by uni1794_17B6.alt;
sub uni1794' @conj.cons.l1 [@conj.cons.l1.001 @conj.cons.l2.002] @conj.cons.l1.001 @vannayutti uni17B6 by uni1794_17B6.alt;

# ----- replace to b7 ------
sub @consonants' lookup replace_to_b7 @conj.cons.l1.001 uni17B7;
sub @consonants' lookup replace_to_b7 @conj.cons.l1 @conj.cons.l1.001 uni17B7;
sub @consonants' lookup replace_to_b7 @conj.cons.l1 [@conj.cons.l1.001 @conj.cons.l2.002] @conj.cons.l1.001 uni17B7;
